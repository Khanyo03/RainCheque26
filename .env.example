# =============================================================================
# RainCheque Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running the application.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Backend: JWT Authentication ---
# Secret key used to sign and verify JWT tokens (min 256-bit / 32 chars recommended)
SPRING_SECURITY_JWT_SECRET=8Gz!Lw97QvX2mK@7RtNp5Yf$JcH8DxUzP4sAe1Bn%Wi6Kr

# --- Backend: QR Code Encryption ---
# Secret key used to encrypt/decrypt QR code payloads
APP_QR_SECRET=Qr9@SeCuRe82026!Nk5Lm8Pv$Wx2Yt7HdFs3BaJq

# --- Database: PostgreSQL (used by docker-compose and Spring Boot prod profile) ---
# Password for the PostgreSQL database user
POSTGRES_PASSWORD=MosGuap2588

# --- Database: Spring Boot Datasource (prod profile) ---
# JDBC connection URL for PostgreSQL (e.g., jdbc:postgresql://localhost:5432/raincheque)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/raincheque

# Database username for the Spring Boot application
SPRING_DATASOURCE_USERNAME=RainCheque26

# Database password for the Spring Boot application
SPRING_DATASOURCE_PASSWORD=RainCheque26

# --- Docker: pgAdmin ---
# Default password for the pgAdmin web interface
PGADMIN_DEFAULT_PASSWORD=admin123

# --- Payment: Stripe ---
# Stripe Secret API Key (starts with sk_test_ or sk_live_)
#STRIPE_API_KEY=

# Stripe Webhook Signing Secret (starts with whsec_)
#STRIPE_WEBHOOK_SECRET=

# --- Payment: Paystack ---
# Paystack API Key (starts with sk_test_ or sk_live_)
PAYSTACK_API_KEY=

# Paystack Webhook Secret (used for HMAC SHA-512 signature verification)
PAYSTACK_WEBHOOK_SECRET=

# --- Frontend: Feature Flags ---
# Set to "true" to enable MSW (Mock Service Worker) in development mode
VITE_ENABLE_MOCKS=fales
